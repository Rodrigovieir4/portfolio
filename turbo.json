{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", "pnpm-workspace.yaml"],
  "globalEnv": ["NODE_ENV", "ANALYZE"],
  "globalPassThroughEnv": ["VERCEL", "VERCEL_ENV", "VERCEL_URL", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_SITE_URL", "NEXT_PUBLIC_PLAUSIBLE_DOMAIN"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "public/**",
        "next.config.ts",
        "postcss.config.mjs",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [".eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
