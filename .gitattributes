# Normaliza tudo em LF dentro do repositorio.
#
# Sem isto, o Git no Windows converte para CRLF na hora do checkout e o
# `pnpm format:check` do CI passa a acusar o repositorio inteiro como
# desformatado, porque o Prettier espera LF. Travar aqui faz Windows, macOS e
# Linux verem exatamente os mesmos bytes.
* text=auto eol=lf

# Binarios nunca sao normalizados.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Trata o lockfile como gerado, para nao poluir a revisao de pull request.
pnpm-lock.yaml linguist-generated=true -diff
