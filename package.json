{
  "name": "portfolio-rodrigovsousa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio profissional de Rodrigo Vieira de Sousa — monorepo Turborepo",
  "author": "Rodrigo Vieira de Sousa <contato.rodrigovsousa@gmail.com>",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "react": {
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7"
      },
      "next": {
        "next": "16.3.4",
        "next-intl": "4.14.2",
        "@next/eslint-plugin-next": "16.3.4"
      },
      "gl": {
        "three": "0.185.1",
        "@types/three": "0.185.4",
        "@react-three/fiber": "9.7.0",
        "@react-three/drei": "10.7.8",
        "@react-three/postprocessing": "3.1.1",
        "postprocessing": "6.39.4"
      },
      "state": {
        "zustand": "5.0.15"
      },
      "motion": {
        "motion": "13.2.0",
        "lenis": "1.3.26"
      },
      "styling": {
        "cn": "0.2.6",
        "radix-ui": "1.6.7",
        "tailwindcss": "4.3.3",
        "@tailwindcss/postcss": "4.3.3",
        "clsx": "2.1.1",
        "tailwind-merge": "3.6.0",
        "class-variance-authority": "0.7.1",
        "lucide-react": "1.43.0",
        "tw-animate-css": "1.4.0"
      },
      "tooling": {
        "typescript": "~6.0.3",
        "eslint": "9.39.5",
        "typescript-eslint": "8.73.0",
        "@eslint/js": "9.39.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react": "7.37.5",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "0.8.1",
        "turbo": "2.10.12",
        "rimraf": "6.1.3",
        "@types/node": "26.5.0",
        "@types/bun": "1.3.14",
        "zod": "4.5.4",
        "@playwright/test": "1.62.1",
        "sharp": "0.35.4"
      }
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && turbo run lint typecheck test build",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "assets:importar": "node scripts/importar-assets.mjs"
  },
  "devDependencies": {
    "@portfolio/eslint-config": "workspace:*",
    "@portfolio/typescript-config": "workspace:*",
    "prettier": "catalog:tooling",
    "prettier-plugin-tailwindcss": "catalog:tooling",
    "rimraf": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling"
  }
}
