# URL publica canonica. Usada em sitemap, robots, metadata e OG images.
NEXT_PUBLIC_SITE_URL="https://rodrigovsousa.dev"

# Opcional: dominio no Plausible para analytics sem cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Endereço da API Elysia (apps/api).
NEXT_PUBLIC_API_URL="localhost:3001"

# Higgsfield API (só servidor e scripts, nunca NEXT_PUBLIC_). Gere o par em
# https://cloud.higgsfield.ai/api-keys, logado na conta do projeto, e preencha
# no .env.local, que não vai para o git.
HF_API_KEY=""
HF_API_SECRET=""
